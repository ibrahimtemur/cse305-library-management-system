flowchart LR
    subgraph Actors["Human Actors"]
        LIB["Librarian / Admin<br/>(ROLE_LIBRARIAN)<br/>e.g., syn-lib-0001"]
        MEM["Library Member<br/>(ROLE_MEMBER: STUDENT,<br/>ACADEMIC_STAFF,<br/>ADMINISTRATIVE_STAFF)<br/>e.g., SYN-STU-0001"]
        GST["Guest Visitor<br/>(ROLE_GUEST)<br/>Unauthenticated"]
    end

    subgraph LMS_Boundary["System Boundary — CSE305 Library Management System"]
        WEB["Spring Boot 3.5.16 Web App<br/>(Spring MVC + Thymeleaf +<br/>Circulation, Fine & Hold Engine)"]
        H2[("Embedded H2 Database<br/>(./data/db/lms)<br/>+ Seed JSON Loader")]
