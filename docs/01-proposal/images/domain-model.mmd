%% General Comments: Conceptual domain model class diagram (Larman Ch. 9) for HW01 Part 3.
classDiagram
    direction TB
    class Book {
        isbn13 : String
        title : String
        subtitle : String
        authors : List~String~
        publisher : String
        firstPublishYear : Integer
        category : String
        subjects : List~String~
        pageCount : Integer
        coverId : Long
        coverUrl : String
        openLibraryWorkKey : String
        referenceOnly : Boolean
    }

    class BookCopy {
        barcode : String
        status : BookCopyStatus
    }

    class Member {
        memberId : String
        firstName : String
        lastName : String
        email : String
        memberType : MemberType
        status : MemberStatus
        department : String
        registeredOn : LocalDate
    }

    class Librarian {
        username : String
        displayName : String
        email : String
        role : String
    }

    class Loan {
        loanId : String
        checkoutDate : LocalDate
        dueDate : LocalDate
        returnDate : LocalDate
        status : LoanStatus
        renewalCount : Integer
        renewedOn : LocalDate
        lostReportedOn : LocalDate
        appraisedValue : BigDecimal [runtime only]
        compensationAmount : BigDecimal [derived, runtime only]
    }

    class Fine {
        fineId : String
        overdueDays : Integer
        amount : BigDecimal
        currency : String
        status : FineStatus
        assessedOn : LocalDate
        settledOn : LocalDate
    }

    class Reservation {
        reservationId : String
        queuePosition : Integer
        status : ReservationStatus
        createdOn : LocalDate
        readyOn : LocalDate
        holdUntil : LocalDate
    }

    class MemberType {
        <<enumeration>>
        STUDENT
        ACADEMIC_STAFF
        ADMINISTRATIVE_STAFF
    }

    class MemberStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
    }

    class BookCopyStatus {
        <<enumeration>>
        AVAILABLE
        LOANED
        RESERVED
        MAINTENANCE
        LOST
    }

    class LoanStatus {
        <<enumeration>>
        ACTIVE
        RETURNED
        LOST
    }

    class FineStatus {
        <<enumeration>>
        UNPAID
        PAID
        WAIVED
    }

    class ReservationStatus {
        <<enumeration>>
        WAITING
        READY
    }

    Book "1" -- "0..*" BookCopy : has >
    Member "1" -- "0..*" Loan : borrows >
    BookCopy "1" -- "0..*" Loan : is lent in >
    Loan "1" -- "0..1" Fine : incurs >
    Librarian "0..1" -- "0..*" Fine : settles >
    Member "1" -- "0..*" Reservation : places >
    Book "1" -- "0..*" Reservation : is reserved through >
    Reservation "0..1" -- "0..1" BookCopy : holds >

    Member ..> MemberType
    Member ..> MemberStatus
    BookCopy ..> BookCopyStatus
    Loan ..> LoanStatus
    Fine ..> FineStatus
    Reservation ..> ReservationStatus

    note for Loan "appraisedValue: entered by the Librarian at runtime, not a seed field<br/>compensationAmount: derived as 2.00 times appraisedValue"
    note for Reservation "Title-level FIFO queue<br/>Only a READY reservation holds one RESERVED copy"
